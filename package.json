{
  "name": "markdown-here-revival",
  "version": "4.0.6",
  "description": "Markdown emails for Mozilla Thunderbird",
  "scripts": {
    "build": "web-ext build",
    "release": "web-ext build -n markdown-here-revival.xpi",
    "lint": "eslint .",
    "test128": "web-ext run --verbose -p mdhr_test_profiles/testing128 -f /home/rob/bin/thunderbird128 --keep-profile-changes",
    "testrelease": "web-ext run --verbose -p mdhr_test_profiles/testingrelease -f /home/rob/bin/thunderbird-release --keep-profile-changes",
    "testbeta": "web-ext run --verbose -f thunderbird-beta --keep-profile-changes",
    "testdaily": "web-ext run --verbose -p mdhr_test_profiles/testingdaily -f thunderbird-daily"
  },
  "type": "module",
  "private": true,
  "author": "JFX",
  "license": "MIT",
  "mocha": {
    "spec": [
      "extension/test/.spec.js"
    ],
    "global": [
      "jQuery",
      "$"
    ],
    "extension": [
      "js",
      "mjs"
    ]
  },
  "devDependencies": {
    "@eslint/css": "^0.8.0",
    "@eslint/js": "^9.26.0",
    "@eslint/json": "^0.12.0",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@textcomplete/contenteditable": "^0.1.13",
    "@textcomplete/core": "^0.1.13",
    "@textcomplete/utils": "^0.1.13",
    "@types/chai-dom": "1.11.3",
    "@types/mocha": "^10.0.10",
    "@types/thunderbird-webext-browser": "^127.0.0",
    "chai": "^5.1.2",
    "chai-dom": "^1.12.0",
    "degausser": "^2.4.4",
    "dompurify": "^3.2.6",
    "emojibase-data": "^15.3.2",
    "esbuild": "^0.25.4",
    "esbuild-plugin-replace-regex": "^0.0.2",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-html": "^8.1.2",
    "eslint-plugin-mailextensions-env": "file:tools/eslint-plugin-mailextensions-env",
    "eslint-plugin-no-unsanitized": "^4.1.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eventemitter3": "^5.0.1",
    "globals": "^16.1.0",
    "highlight.js": "^11.10.0",
    "marked": "^14.1.4",
    "marked-directive": "^1.0.7",
    "marked-emoji": "^1.4.3",
    "marked-extended-tables": "1.0.10",
    "marked-highlight": "^2.2.1",
    "marked-linkify-it": "^3.1.12",
    "mocha": "^10.8.2",
    "prettier": "^3.5.3",
    "rollup": "^4.17.2",
    "turndown": "^7.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "web-ext": "^8.6.0"
  }
}